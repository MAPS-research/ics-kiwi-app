{
  "name": "ics-kiwi-app",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8100",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8100",
    "test": "vitest run",
    "test:server": ".venv/bin/python -m unittest discover -s server -p 'test_*.py'",
    "test:bridge": "node --test scripts/sdk-contract.test.mjs",
    "test:scripts": "node --test scripts/sdk-contract.test.mjs",
    "postinstall": "npm run prepare:webr",
    "prepare:webr": "node scripts/copy-webr.mjs",
    "demo:setup": "node scripts/retired-demo.mjs",
    "demo:start": "node scripts/retired-demo.mjs",
    "demo:stop": "node scripts/retired-demo.mjs",
    "demo:status": "node scripts/retired-demo.mjs",
    "demo:seed": "node scripts/retired-demo.mjs",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/**"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webr": "0.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
