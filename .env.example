# CSS Kiwi Lab v0.6.0 — copy to .env and fill in. The server reads .env at start; real environment variables win.

# Instructor key for the standalone demo classes. There is no default: leave it empty and the standalone teacher
# workspace stays closed (503 teacher_key_not_configured). Set a long random value, e.g. `openssl rand -hex 24`.
KIWI_TEACHER_KEY=
# Standalone classes that accept student writes without a course row (comma-separated).
# KIWI_STANDALONE_CLASS_IDS=local-r-class

# Server-only AI key for the Lab AI tutor and generated practice; also used by the local Kiwi demo.
# OPENAI_API_KEY is accepted as an alternative. Without a key, Ask Kiwi answers with local guidance and practice uses
# local templates.
OPEN_AI_TEST_KEY=
KIWI_DEMO_MODEL=gpt-5.4-mini
# Models teachers may pick in AI tutor rules (comma-separated; default: KIWI_DEMO_MODEL).
# KIWI_MODEL_ALLOWLIST=gpt-5.4-mini
# Concurrent provider calls per server process and the longest wait for a free slot (seconds).
# KIWI_AI_CONCURRENCY=4
# KIWI_AI_QUEUE_WAIT_S=20
# AI requests per client address per minute (standalone classes only).
KIWI_AI_PER_IP_PER_MINUTE=60

# Client copies of server-owned events (answer_submitted, ai_question, …). Empty = the code default `enforce`
# (v2 client copies are refused with 422); `accept` stores them flagged as client-reported.
KIWI_SERVER_OWNED_EVENTS=

# Optional SQLite location. Defaults to ./data/kiwi-lab.sqlite3. Backups before migrations go to <db dir>/backups/.
# KIWI_DB_PATH=/absolute/path/kiwi-lab.sqlite3
# Port of the app API. Vite's dev proxy reads KIWI_API_PORT from the shell, not from this file:
# KIWI_API_PORT=8401 python3 server/app.py  and  KIWI_API_PORT=8401 npx vite --port 8421 --strictPort
# KIWI_API_PORT=8101
# Commit recorded in research packages.
# KIWI_GIT_SHA=

# Optional Kiwi UI origin for the canonical SDK bundle when embedded.
# VITE_KIWI_ORIGIN=http://localhost:3001
# Verified course identity and native activity export (server only).
KIWI_API_ORIGIN=http://localhost:3000
KIWI_CLASS_IDS=local-css-demo
# Optional approved Kiwi contextualChat prompt ID.
# VITE_KIWI_CONTEXT_PROMPT_ID=your-approved-prompt-id
