# CSS Kiwi Lab v0.7.0 — Lab settings only. No Kiwi checkout or provider keys.
# Standalone teacher key. Generate a long value with: openssl rand -hex 24
KIWI_TEACHER_KEY=
KIWI_API_ORIGIN=http://localhost:3000
# Approved prompt supplied by the Kiwi administrator. Must match enabled scopes.
KIWI_CONTEXT_PROMPT_ID=lab-tutor
# Server-only explicit Lab roles: course UUID -> user UUID -> role.
# Example: {"course-uuid":{"teacher-user-uuid":"instructor"}}
KIWI_STAFF_BINDINGS={}
# Linked courses may also be listed explicitly; verified sessions link automatically.
KIWI_CLASS_IDS=
# Optional expected JWT issuer if your host issues an iss claim.
# KIWI_JWT_ISSUER=https://kiwi.example.edu
# Official UI origin, for loading its SDK in an iframe (Vite reads .env at start).
# VITE_KIWI_ORIGIN=http://localhost:3001
# Optional isolated database / API port. Export KIWI_API_PORT for Vite too.
# KIWI_DB_PATH=/absolute/path/kiwi-lab.sqlite3
# KIWI_API_PORT=8101
# KIWI_PYTHON=.venv/bin/python
KIWI_AI_PER_IP_PER_MINUTE=60
# KIWI_AI_CONCURRENCY=4
# KIWI_AI_QUEUE_WAIT_S=20
# No OPENAI_API_KEY / OPEN_AI_TEST_KEY: v0.7 never reads them for AI.
